                  "outputText": "@{outputs('Итог_успеха')?['outputText']}",
                  "inputTokens": "@outputs('Итог_успеха')?['inputTokens']",
                  "outputTokens": "@outputs('Итог_успеха')?['outputTokens']",
                  "costUsd": "@outputs('Стоимость')",
                  "errorCode": "",
                  "errorText": "",
                  "latencyMs": "@outputs('Задержка')"
