                ]
              },
              "inputs": {
                "host": {
                  "connectionName": "shared_commondataserviceforapps",
                  "operationId": "ListRecords",
                  "apiId": "/providers/Microsoft.PowerApps/apis/shared_commondataserviceforapps"
                },
                "parameters": {
                  "entityName": "new_examticketitems",
                  "$filter": "statecode eq 0 and _new_attempt_value eq '@{triggerBody()?['text']}'",
                  "$select": "new_examticketitemid,new_order,new_type,new_points,new_earned,new_neutralized,new_status,_new_question_value",
                  "$orderby": "new_order asc",
                  "$top": 300
