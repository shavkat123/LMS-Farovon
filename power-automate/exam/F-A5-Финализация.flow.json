            },
            "Разбор_заданий": {
              "type": "Foreach",
              "runAfter": {
                "Первичная_финализация": [
                  "Succeeded"
                ]
              },
              "foreach": "@outputs('Задания')?['body/value']",
              "runtimeConfiguration": {
                "concurrency": {
                  "repetitions": 5
                }
              },
              "actions": {
                "Это_задание_с_выбором": {
                  "type": "If",
                  "runAfter": {},
                  "expression": {
                    "or": [
                      {
                        "equals": [
                          "@items('Разбор_заданий')?['new_type']",
                          "@outputs('Константы')['type']['single']"
                        ]
                      },
                      {
                        "equals": [
                          "@items('Разбор_заданий')?['new_type']",
                          "@outputs('Константы')['type']['multi']"
                        ]
                      }
                    ]
                  },
                  "actions": {
                    "Вопрос": {
                      "type": "OpenApiConnection",
                      "runAfter": {},
                      "inputs": {
                        "host": {
                          "connectionName": "shared_commondataserviceforapps",
                          "operationId": "GetItem",
                          "apiId": "/providers/Microsoft.PowerApps/apis/shared_commondataserviceforapps"
                        },
                        "parameters": {
                          "entityName": "new_examquestions",
                          "recordId": "@items('Разбор_заданий')?['_new_question_value']"
                        },
                        "authentication": "@parameters('$authentication')"
                      }
                    },
                    "Принятый_ответ": {
                      "type": "OpenApiConnection",
                      "runAfter": {
                        "Вопрос": [
                          "Succeeded"
                        ]
                      },
                      "inputs": {
                        "host": {
                          "connectionName": "shared_commondataserviceforapps",
                          "operationId": "ListRecords",
                          "apiId": "/providers/Microsoft.PowerApps/apis/shared_commondataserviceforapps"
                        },
                        "parameters": {
                          "entityName": "new_examanswers",
                          "$filter": "statecode eq 0 and _new_ticketitem_value eq '@{items('Разбор_заданий')?['new_examticketitemid']}' and new_accepted eq true",
                          "$select": "new_selected,new_text",
                          "$top": 1
                        },
                        "authentication": "@parameters('$authentication')"
                      }
                    },
                    "Верные_варианты": {
                      "type": "Query",
                      "runAfter": {
                        "Принятый_ответ": [
                          "Succeeded"
                        ]
                      },
                      "inputs": {
                        "from": "@json(coalesce(outputs('Вопрос')?['body/new_optionsjson'], '[]'))",
                        "where": "@equals(coalesce(item()?['correct'], false), true)"
                      }
                    },
                    "Разбор_выбора": {
                      "type": "Compose",
                      "runAfter": {
                        "Верные_варианты": [
                          "Succeeded"
                        ]
                      },
                      "inputs": {
                        "kind": "choice",
                        "mode": "@{coalesce(outputs('P')?['revealMode'], 'full')}",
                        "selected": "@if(equals(length(outputs('Принятый_ответ')?['body/value']), 0), '', coalesce(first(outputs('Принятый_ответ')?['body/value'])?['new_selected'], ''))",
                        "correct": "@if(equals(coalesce(outputs('P')?['revealMode'], 'full'), 'full'), body('Верные_варианты'), null)",
                        "explanation": "@if(equals(coalesce(outputs('P')?['revealMode'], 'full'), 'full'), coalesce(outputs('Вопрос')?['body/new_explanation'], ''), '')",
                        "earned": "@coalesce(items('Разбор_заданий')?['new_earned'], 0)",
                        "points": "@coalesce(items('Разбор_заданий')?['new_points'], 0)",
                        "neutralized": "@coalesce(items('Разбор_заданий')?['new_neutralized'], false)"
                      }
                    },
                    "Записать_разбор_выбора": {
                      "type": "OpenApiConnection",
                      "runAfter": {
                        "Разбор_выбора": [
                          "Succeeded"
                        ]
                      },
                      "inputs": {
                        "host": {
                          "connectionName": "shared_commondataserviceforapps",
                          "operationId": "UpdateOnlyRecord",
                          "apiId": "/providers/Microsoft.PowerApps/apis/shared_commondataserviceforapps"
                        },
                        "parameters": {
                          "entityName": "new_examticketitems",
                          "recordId": "@items('Разбор_заданий')?['new_examticketitemid']",
                          "item/new_revealjson": "@{string(outputs('Разбор_выбора'))}",
                          "item/new_status": "@if(equals(coalesce(items('Разбор_заданий')?['new_neutralized'], false), true), outputs('Константы')['itemНейтрализован'], outputs('Константы')['itemОценён'])"
                        },
                        "authentication": "@parameters('$authentication')"
                      }
                    }
                  },
                  "else": {
                    "actions": {
                      "Оценка_задания": {
                        "type": "Query",
                        "runAfter": {},
                        "inputs": {
                          "from": "@outputs('Итоговые_оценки')?['body/value']",
                          "where": "@equals(item()?['_new_ticketitem_value'], items('Разбор_заданий')?['new_examticketitemid'])"
                        }
                      },
                      "Разбор_письменного": {
                        "type": "Compose",
                        "runAfter": {
                          "Оценка_задания": [
                            "Succeeded"
                          ]
                        },
                        "inputs": {
                          "kind": "written",
                          "criteria": "@if(equals(length(body('Оценка_задания')), 0), json('[]'), json(coalesce(first(body('Оценка_задания'))?['new_criteriajson'], '[]')))",
                          "earned": "@if(equals(length(body('Оценка_задания')), 0), 0, coalesce(first(body('Оценка_задания'))?['new_score'], 0))",
                          "points": "@coalesce(items('Разбор_заданий')?['new_points'], 0)",
                          "neutralized": "@coalesce(items('Разбор_заданий')?['new_neutralized'], false)"
                        }
                      },
                      "Записать_разбор_письменного": {
                        "type": "OpenApiConnection",
                        "runAfter": {
                          "Разбор_письменного": [
                            "Succeeded"
                          ]
                        },
                        "inputs": {
                          "host": {
                            "connectionName": "shared_commondataserviceforapps",
                            "operationId": "UpdateOnlyRecord",
                            "apiId": "/providers/Microsoft.PowerApps/apis/shared_commondataserviceforapps"
                          },
                          "parameters": {
                            "entityName": "new_examticketitems",
                            "recordId": "@items('Разбор_заданий')?['new_examticketitemid']",
                            "item/new_revealjson": "@{string(outputs('Разбор_письменного'))}",
                            "item/new_earned": "@if(equals(length(body('Оценка_задания')), 0), 0, coalesce(first(body('Оценка_задания'))?['new_score'], 0))",
                            "item/new_status": "@if(equals(coalesce(items('Разбор_заданий')?['new_neutralized'], false), true), outputs('Константы')['itemНейтрализован'], outputs('Константы')['itemОценён'])"
                          },
                          "authentication": "@parameters('$authentication')"
                        }
                      }
                    }
                  }
                }
              }
            },
            "Попытки_сотрудника": {
              "type": "OpenApiConnection",
              "runAfter": {
                "Разбор_заданий": [
                  "Succeeded"
                ]
              },
              "inputs": {
                "host": {
                  "connectionName": "shared_commondataserviceforapps",
                  "operationId": "ListRecords",
                  "apiId": "/providers/Microsoft.PowerApps/apis/shared_commondataserviceforapps"
                },
                "parameters": {
                  "entityName": "new_examattempts",
                  "$filter": "statecode eq 0 and _new_exam_value eq '@{outputs('Попытка')?['body/_new_exam_value']}' and _new_contact_value eq '@{outputs('Попытка')?['body/_new_contact_value']}' and new_status ne 100000005",
                  "$select": "new_examattemptid,new_percent,new_passed,new_result,new_finalizedon,new_attemptno,new_isfinal",
                  "$top": 50
                },
                "authentication": "@parameters('$authentication')"
              }
            },
            "Ключи_итоговой": {
              "type": "Select",
              "runAfter": {
                "Попытки_сотрудника": [
                  "Succeeded"
                ]
              },
              "inputs": {
                "from": "@outputs('Попытки_сотрудника')?['body/value']",
                "select": {
                  "id": "@item()?['new_examattemptid']",
                  "k": "@if(equals(coalesce(outputs('P')?['attemptRule'], 'best'), 'last'), int(coalesce(item()?['new_attemptno'], 0)), add(mul(int(mul(float(coalesce(item()?['new_percent'], 0)), 100)), 1000), int(coalesce(item()?['new_attemptno'], 0))))",
                  "passed": "@coalesce(item()?['new_passed'], false)"
                }
              }
            },
            "Итоговая_попытка": {
              "type": "Compose",
              "runAfter": {
                "Ключи_итоговой": [
                  "Succeeded"
                ]
              },
              "inputs": "@last(sort(body('Ключи_итоговой'), 'k'))"
            },
            "Цикл_отметок_итога": {
              "type": "Foreach",
              "runAfter": {
                "Итоговая_попытка": [
                  "Succeeded"
                ]
              },
              "foreach": "@outputs('Попытки_сотрудника')?['body/value']",
              "runtimeConfiguration": {
                "concurrency": {
                  "repetitions": 5
                }
              },
              "actions": {
                "Отметить_итоговую": {
                  "type": "OpenApiConnection",
                  "runAfter": {},
                  "inputs": {
                    "host": {
                      "connectionName": "shared_commondataserviceforapps",
                      "operationId": "UpdateOnlyRecord",
                      "apiId": "/providers/Microsoft.PowerApps/apis/shared_commondataserviceforapps"
                    },
                    "parameters": {
                      "entityName": "new_examattempts",
                      "recordId": "@items('Цикл_отметок_итога')?['new_examattemptid']",
                      "item/new_isfinal": "@equals(items('Цикл_отметок_итога')?['new_examattemptid'], outputs('Итоговая_попытка')?['id'])"
                    },
                    "authentication": "@parameters('$authentication')"
                  }
                }
              }
            },
            "Сертификаты_сотрудника": {
              "type": "OpenApiConnection",
              "description": "Берём только действующие сертификаты: отозванный или истёкший не должен мешать выдать новый после повторной сдачи, а при несдаче отзывать повторно уже отозванные (и писать CERT_REVOKED каждый раз) незачем.",
              "runAfter": {
                "Цикл_отметок_итога": [
                  "Succeeded"
                ]
              },
              "inputs": {
                "host": {
                  "connectionName": "shared_commondataserviceforapps",
                  "operationId": "ListRecords",
                  "apiId": "/providers/Microsoft.PowerApps/apis/shared_commondataserviceforapps"
                },
                "parameters": {
                  "entityName": "new_certifications",
                  "$filter": "statecode eq 0 and _new_exam_value eq '@{outputs('Попытка')?['body/_new_exam_value']}' and _new_contact_value eq '@{outputs('Попытка')?['body/_new_contact_value']}' and new_status eq @{outputs('Константы')['certДействует']}",
                  "$select": "new_certificationid,new_status,new_validuntil",
                  "$top": 10
                },
                "authentication": "@parameters('$authentication')"
              }
            },
            "Итог_сдан": {
              "type": "If",
              "runAfter": {
                "Сертификаты_сотрудника": [
                  "Succeeded"
                ]
              },
              "expression": {
                "equals": [
                  "@outputs('Итоговая_попытка')?['passed']",
                  true
                ]
              },
              "actions": {
                "Нет_ли_сертификата": {
                  "type": "If",
                  "runAfter": {},
                  "expression": {
                    "equals": [
                      "@length(outputs('Сертификаты_сотрудника')?['body/value'])",
                      0
                    ]
                  },
                  "actions": {
                    "Выдать_сертификат": {
                      "type": "OpenApiConnection",
                      "runAfter": {},
                      "inputs": {
                        "host": {
                          "connectionName": "shared_commondataserviceforapps",
                          "operationId": "CreateRecord",
                          "apiId": "/providers/Microsoft.PowerApps/apis/shared_commondataserviceforapps"
                        },
                        "parameters": {
                          "entityName": "new_certifications",
                          "item/new_issuedon": "@{utcNow('yyyy-MM-dd')}",
                          "item/new_validuntil": "@{addToTime(utcNow(), int(coalesce(outputs('Экзамен')?['body/new_certvalidmonths'], 12)), 'Month', 'yyyy-MM-dd')}",
                          "item/new_status": "@outputs('Константы')['certДействует']",
                          "item/new_contact@odata.bind": "/contacts(@{outputs('Попытка')?['body/_new_contact_value']})",
                          "item/new_exam@odata.bind": "/new_exams(@{outputs('Попытка')?['body/_new_exam_value']})",
                          "item/new_attempt@odata.bind": "/new_examattempts(@{outputs('Итоговая_попытка')?['id']})"
                        },
                        "authentication": "@parameters('$authentication')"
                      }
                    },
                    "Журнал_выдачи": {
                      "type": "OpenApiConnection",
                      "runAfter": {
                        "Выдать_сертификат": [
                          "Succeeded"
                        ]
                      },
                      "inputs": {
                        "host": {
                          "connectionName": "shared_commondataserviceforapps",
                          "operationId": "CreateRecord",
                          "apiId": "/providers/Microsoft.PowerApps/apis/shared_commondataserviceforapps"
                        },
                        "parameters": {
                          "entityName": "new_examlogs",
                          "item/new_event": "CERT_ISSUED",
                          "item/new_actor": "F-A5 Финализация",
                          "item/new_subjectid": "@outputs('Попытка')?['body/_new_contact_value']",
                          "item/new_exam@odata.bind": "/new_exams(@{outputs('Попытка')?['body/_new_exam_value']})",
                          "item/new_attempt@odata.bind": "/new_examattempts(@{triggerBody()?['text']})"
                        },
                        "authentication": "@parameters('$authentication')"
                      }
                    }
                  },
                  "else": {
                    "actions": {}
                  }
                }
              },
              "else": {
                "actions": {
                  "Цикл_отзыва": {
                    "type": "Foreach",
                    "runAfter": {},
                    "foreach": "@outputs('Сертификаты_сотрудника')?['body/value']",
                    "runtimeConfiguration": {
                      "concurrency": {
                        "repetitions": 1
                      }
                    },
                    "actions": {
                      "Отозвать": {
                        "type": "OpenApiConnection",
                        "runAfter": {},
                        "inputs": {
                          "host": {
                            "connectionName": "shared_commondataserviceforapps",
                            "operationId": "UpdateOnlyRecord",
                            "apiId": "/providers/Microsoft.PowerApps/apis/shared_commondataserviceforapps"
                          },
                          "parameters": {
                            "entityName": "new_certifications",
                            "recordId": "@items('Цикл_отзыва')?['new_certificationid']",
                            "item/new_status": "@outputs('Константы')['certОтозван']",
                            "item/new_revokereason": "@{concat('Итог экзамена изменён: ', triggerBody()?['text_1'])}"
                          },
                          "authentication": "@parameters('$authentication')"
                        }
                      },
                      "Журнал_отзыва": {
                        "type": "OpenApiConnection",
                        "runAfter": {
                          "Отозвать": [
                            "Succeeded"
                          ]
                        },
                        "inputs": {
                          "host": {
                            "connectionName": "shared_commondataserviceforapps",
                            "operationId": "CreateRecord",
                            "apiId": "/providers/Microsoft.PowerApps/apis/shared_commondataserviceforapps"
                          },
                          "parameters": {
                            "entityName": "new_examlogs",
                            "item/new_event": "CERT_REVOKED",
                            "item/new_actor": "F-A5 Финализация",
                            "item/new_subjectid": "@items('Цикл_отзыва')?['new_certificationid']",
                            "item/new_attempt@odata.bind": "/new_examattempts(@{triggerBody()?['text']})"
                          },
                          "authentication": "@parameters('$authentication')"
                        }
                      }
                    }
                  }
                }
              }
            },
            "Журнал_итога": {
              "type": "OpenApiConnection",
              "runAfter": {
                "Итог_сдан": [
                  "Succeeded"
                ]
              },
              "inputs": {
                "host": {
                  "connectionName": "shared_commondataserviceforapps",
                  "operationId": "CreateRecord",
                  "apiId": "/providers/Microsoft.PowerApps/apis/shared_commondataserviceforapps"
                },
                "parameters": {
                  "entityName": "new_examlogs",
                  "item/new_event": "RESULT_FINAL",
                  "item/new_actor": "@{concat('F-A5 Финализация (', triggerBody()?['text_1'], ')')}",
                  "item/new_subjectid": "@triggerBody()?['text']",
                  "item/new_payload": "@{concat('{\"percent\":', string(outputs('Процент')), ',\"casePercent\":', string(outputs('КейсПроцент')), ',\"passed\":', string(outputs('Сдано')), ',\"version\":', string(add(int(coalesce(outputs('Попытка')?['body/new_resultversion'], 0)), 1)), ',\"blocks\":', string(variables('Блоки')), '}')}",
                  "item/new_exam@odata.bind": "/new_exams(@{outputs('Попытка')?['body/_new_exam_value']})",
                  "item/new_attempt@odata.bind": "/new_examattempts(@{triggerBody()?['text']})"
                },
                "authentication": "@parameters('$authentication')"
              }
            },
            "Ответ": {
              "type": "Response",
              "kind": "Http",
              "runAfter": {
                "Журнал_итога": [
                  "Succeeded"
                ]
              },
              "inputs": {
                "statusCode": 200,
                "body": {
                  "ok": true,
                  "percent": "@outputs('Процент')",
                  "casePercent": "@outputs('КейсПроцент')",
                  "passed": "@outputs('Сдано')"
                },
                "schema": {
                  "type": "object",
                  "properties": {
                    "ok": {
                      "type": "boolean"
                    },
                    "percent": {
                      "type": "number"
                    },
                    "casePercent": {
                      "type": "number"
                    },
                    "passed": {
                      "type": "boolean"
                    }
                  }
                }
              }
            }
          }
        },
        "Catch": {
          "type": "Scope",
          "runAfter": {
            "Try": [
              "Failed",
              "TimedOut"
            ]
          },
          "actions": {
            "Журнал_сбоя": {
              "type": "OpenApiConnection",
              "runAfter": {},
              "inputs": {
                "host": {
                  "connectionName": "shared_commondataserviceforapps",
                  "operationId": "CreateRecord",
                  "apiId": "/providers/Microsoft.PowerApps/apis/shared_commondataserviceforapps"
                },
                "parameters": {
                  "entityName": "new_examlogs",
                  "item/new_event": "FLOW_ERROR",
                  "item/new_actor": "F-A5 Финализация",
                  "item/new_subjectid": "@{workflow()?['run']?['name']}",
                  "item/new_payload": "@{string(result('Try'))}"
                },
                "authentication": "@parameters('$authentication')"
              }
            },
            "Ответ_с_ошибкой": {
              "type": "Response",
              "kind": "Http",
              "runAfter": {
                "Журнал_сбоя": [
                  "Succeeded"
                ]
              },
              "inputs": {
                "statusCode": 200,
                "body": {
                  "ok": false,
                  "percent": 0,
                  "casePercent": 0,
                  "passed": false
                },
                "schema": {
                  "type": "object",
                  "properties": {
                    "ok": {
                      "type": "boolean"
                    },
                    "percent": {
                      "type": "number"
                    },
                    "casePercent": {
                      "type": "number"
                    },
                    "passed": {
                      "type": "boolean"
                    }
                  }
                }
              }
            }
          }
        }
      },
      "outputs": {}
    },
    "templateName": null
  },
  "schemaVersion": "1.0.0.0"
}
