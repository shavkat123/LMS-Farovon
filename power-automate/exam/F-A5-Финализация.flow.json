              },
              "inputs": "@if(equals(triggerBody()?['text_1'], 'Аннулирование'), outputs('Константы')['resultАннулировано'], if(equals(outputs('Сдано'), true), outputs('Константы')['resultСдано'], outputs('Константы')['resultНеСдано']))"
            },
            "Обновить_попытку": {
              "type": "OpenApiConnection",
              "description": "При аннулировании снимаем new_isfinal в том же обновлении, что и статус: цикл отметок итога обходит только неаннулированные попытки, поэтому иначе аннулированная попытка могла остаться «итоговой». В остальных режимах флаг сохраняется как был — его переставит цикл отметок.",
              "runAfter": {
                "Результат": [
                  "Succeeded"
                ]
              },
              "inputs": {
                "host": {
                  "connectionName": "shared_commondataserviceforapps",
                  "operationId": "UpdateOnlyRecord",
                  "apiId": "/providers/Microsoft.PowerApps/apis/shared_commondataserviceforapps"
                },
                "parameters": {
                  "entityName": "new_examattempts",
                  "recordId": "@triggerBody()?['text']",
                  "item/new_percent": "@outputs('Процент')",
                  "item/new_casepercent": "@outputs('КейсПроцент')",
                  "item/new_passed": "@outputs('Сдано')",
                  "item/new_result": "@outputs('Результат')",
                  "item/new_blockscores": "@{string(variables('Блоки'))}",
                  "item/new_status": "@if(equals(triggerBody()?['text_1'], 'Аннулирование'), outputs('Константы')['attemptАннулирован'], outputs('Константы')['attemptОценён'])",
                  "item/new_isfinal": "@if(equals(triggerBody()?['text_1'], 'Аннулирование'), false, coalesce(outputs('Попытка')?['body/new_isfinal'], false))",
                  "item/new_resultversion": "@add(int(coalesce(outputs('Попытка')?['body/new_resultversion'], 0)), 1)"
                },
                "authentication": "@parameters('$authentication')"
              }
            },
            "Первичная_финализация": {
              "type": "If",
              "runAfter": {
                "Обновить_попытку": [
                  "Succeeded"
                ]
              },
              "expression": {
                "equals": [
                  "@triggerBody()?['text_1']",
                  "Первичная"
                ]
              },
              "actions": {
                "Проставить_сроки": {
                  "type": "OpenApiConnection",
                  "runAfter": {},
                  "inputs": {
                    "host": {
                      "connectionName": "shared_commondataserviceforapps",
                      "operationId": "UpdateOnlyRecord",
                      "apiId": "/providers/Microsoft.PowerApps/apis/shared_commondataserviceforapps"
                    },
                    "parameters": {
                      "entityName": "new_examattempts",
                      "recordId": "@triggerBody()?['text']",
                      "item/new_finalizedon": "@{utcNow()}",
