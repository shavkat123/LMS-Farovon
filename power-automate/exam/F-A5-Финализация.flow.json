                ]
              },
              "inputs": "@if(greater(variables('ВесаСумма'), 0), float(formatNumber(mul(div(variables('ВзвешенныйИтог'), variables('ВесаСумма')), 100), '0.00', 'en-US')), 0)"
            },
            "КейсПроцент": {
              "type": "Compose",
              "runAfter": {
                "Процент": [
