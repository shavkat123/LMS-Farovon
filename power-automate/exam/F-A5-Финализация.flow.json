                      }
                    }
                  },
                  "else": {
                    "actions": {}
                  }
                },
                "Это_кейсы": {
                  "type": "If",
                  "runAfter": {
                    "Блок_не_пуст": [
                      "Succeeded"
                    ]
                  },
                  "expression": {
                    "equals": [
                      "@items('Цикл_блоков')?['type']",
                      "case"
                    ]
                  },
                  "actions": {
                    "Запомнить_кейс_набрано": {
                      "type": "SetVariable",
                      "runAfter": {},
                      "inputs": {
                        "name": "КейсНабрано",
                        "value": "@variables('Заработано')"
                      }
                    },
                    "Запомнить_кейс_макс": {
                      "type": "SetVariable",
                      "runAfter": {
                        "Запомнить_кейс_набрано": [
                          "Succeeded"
                        ]
                      },
                      "inputs": {
                        "name": "КейсМакс",
                        "value": "@variables('Максимум')"
                      }
                    }
                  },
                  "else": {
                    "actions": {}
                  }
                },
                "Добавить_блок": {
                  "type": "AppendToArrayVariable",
                  "runAfter": {
                    "Это_кейсы": [
                      "Succeeded"
                    ]
                  },
                  "inputs": {
                    "name": "Блоки",
                    "value": {
                      "type": "@{items('Цикл_блоков')?['type']}",
                      "weight": "@items('Цикл_блоков')?['weight']",
                      "earned": "@variables('Заработано')",
                      "max": "@variables('Максимум')"
                    }
                  }
                }
              }
            },
            "Процент": {
              "type": "Compose",
              "runAfter": {
                "Цикл_блоков": [
