              },
              "actions": {
                "Тип_блока": {
                  "type": "Compose",
                  "runAfter": {},
                  "inputs": "@outputs('Константы')['type'][items('Цикл_блоков')?['type']]"
                },
                "Задания_блока": {
                  "type": "Query",
                  "runAfter": {
                    "Тип_блока": [
                      "Succeeded"
                    ]
                  },
                  "inputs": {
                    "from": "@outputs('Задания')?['body/value']",
