              "inputs": "@if(empty(coalesce(outputs('Экзамен')?['body/new_configsnapshot'], '')), json(coalesce(outputs('Экзамен')?['body/new_paramsjson'], '{}')), json(outputs('Экзамен')?['body/new_configsnapshot'])?['params'])"
