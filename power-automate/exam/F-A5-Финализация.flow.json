                "Сбросить_Заработано": {
                  "type": "SetVariable",
                  "runAfter": {
                    "Задания_блока": [
                      "Succeeded"
                    ]
                  },
                  "inputs": {
                    "name": "Заработано",
                    "value": 0
                  }
                },
                "Сбросить_Максимум": {
                  "type": "SetVariable",
                  "runAfter": {
                    "Сбросить_Заработано": [
                      "Succeeded"
                    ]
                  },
                  "inputs": {
                    "name": "Максимум",
                    "value": 0
                  }
                },
                "Цикл_заданий_блока": {
                  "type": "Foreach",
                  "runAfter": {
                    "Сбросить_Максимум": [
                      "Succeeded"
                    ]
                  },
                  "foreach": "@body('Задания_блока')",
                  "runtimeConfiguration": {
                    "concurrency": {
                      "repetitions": 1
                    }
                  },
                  "actions": {
                    "Учитывать_задание": {
                      "type": "If",
                      "runAfter": {},
                      "expression": {
                        "or": [
                          {
                            "not": {
                              "equals": [
                                "@coalesce(items('Цикл_заданий_блока')?['new_neutralized'], false)",
                                true
                              ]
                            }
                          },
                          {
                            "equals": [
                              "@coalesce(outputs('P')?['neutralizeRule'], 'exclude')",
                              "creditAll"
                            ]
                          }
                        ]
                      },
                      "actions": {
                        "Плюс_максимум": {
                          "type": "IncrementVariable",
                          "runAfter": {},
                          "inputs": {
                            "name": "Максимум",
                            "value": "@float(coalesce(items('Цикл_заданий_блока')?['new_points'], 0))"
                          }
                        },
                        "Плюс_заработано": {
                          "type": "IncrementVariable",
                          "runAfter": {
                            "Плюс_максимум": [
                              "Succeeded"
                            ]
                          },
                          "inputs": {
                            "name": "Заработано",
                            "value": "@if(equals(coalesce(items('Цикл_заданий_блока')?['new_neutralized'], false), true), float(coalesce(items('Цикл_заданий_блока')?['new_points'], 0)), if(or(equals(items('Цикл_заданий_блока')?['new_type'], outputs('Константы')['type']['case']), equals(items('Цикл_заданий_блока')?['new_type'], outputs('Константы')['type']['control'])), float(coalesce(outputs('КартаОценок')?[items('Цикл_заданий_блока')?['new_examticketitemid']], 0)), float(coalesce(items('Цикл_заданий_блока')?['new_earned'], 0))))"
                          }
                        }
                      },
                      "else": {
                        "actions": {}
                      }
                    }
                  }
                },
                "Блок_не_пуст": {
                  "type": "If",
                  "runAfter": {
                    "Цикл_заданий_блока": [
                      "Succeeded"
                    ]
                  },
                  "expression": {
                    "greater": [
                      "@variables('Максимум')",
                      0
                    ]
                  },
                  "actions": {
                    "Плюс_вес": {
                      "type": "IncrementVariable",
                      "runAfter": {},
                      "inputs": {
                        "name": "ВесаСумма",
                        "value": "@float(items('Цикл_блоков')?['weight'])"
                      }
                    },
                    "Плюс_взвешенное": {
                      "type": "IncrementVariable",
                      "runAfter": {
                        "Плюс_вес": [
                          "Succeeded"
                        ]
                      },
                      "inputs": {
                        "name": "ВзвешенныйИтог",
