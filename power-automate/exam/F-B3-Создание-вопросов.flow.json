                                      "body": { "text": "@{outputs('Создать_вопрос')?['body/new_examquestionid']}" }
                                    }
                                  },
                                  "Плюс_стоимость_рецензии": {
                                    "type": "IncrementVariable", "runAfter": { "Проверить_вопрос": [ "Succeeded" ] },
                                    "inputs": { "name": "Стоимость", "value": "@float(coalesce(body('Проверить_вопрос')?['costUsd'], 0))" }
                                  },
                                  "Итог_рецензии": {
                                    "type": "If",
                                    "runAfter": { "Плюс_стоимость_рецензии": [ "Succeeded" ] },
                                    "expression": { "equals": [ "@body('Проверить_вопрос')?['approved']", true ] },
                                    "actions": { "Плюс_одобрено": { "type": "IncrementVariable", "runAfter": {}, "inputs": { "name": "Одобрено", "value": 1 } } },
                                    "else": { "actions": { "Плюс_отклонено_рецензентом": { "type": "IncrementVariable", "runAfter": {}, "inputs": { "name": "Отклонено", "value": 1 } } } }
                                  }
                                },
                                "else": {
                                  "actions": {
                                    "Плюс_отклонено_проверкой": { "type": "IncrementVariable", "runAfter": {}, "inputs": { "name": "Отклонено", "value": 1 } },
                                    "Заметка_о_браке": {
                                      "type": "AppendToArrayVariable",
