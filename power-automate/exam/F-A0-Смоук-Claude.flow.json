              "inputs": {
                "statusCode": 200,
                "body": { "ok": false, "model": "@outputs('Модель')", "text": "", "inputTokens": 0, "outputTokens": 0 },
                "schema": {
                  "type": "object",
                  "properties": {
                    "ok": { "type": "boolean" },
                    "model": { "type": "string" },
                    "text": { "type": "string" },
                    "inputTokens": { "type": "integer" },
                    "outputTokens": { "type": "integer" }
                  }
                }
              }
            }
          }
        }
      },
      "outputs": {}
    },
    "templateName": null
  },
